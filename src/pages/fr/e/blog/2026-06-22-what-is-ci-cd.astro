import Base from '../../../../layouts/Base.astro';
const path = '/fr/e/blog/2026-06-22-what-is-ci-cd.html';
const title = 'C’est quoi le CI/CD ? Intégration continue et livraison continue, avec un vrai pipeline';
const description = 'Le CI/CD, c’est l’intégration continue (CI : chaque push est construit et testé) et la livraison ou le déploiement continu (CD : le code testé part en production). Définition claire, un pipeline GitHub Actions complet commenté ligne par ligne, et où le faire tourner.';
const pipeline = `# .github/workflows/ci.yml
name: ci
on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:            # CI : construire et tester
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: npm ci
      - run: npm test

  deploy:          # CD : si les tests passent, sur main
    needs: test
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    steps:
      - name: Déployer sur le serveur par SSH
        env:
          SSH_KEY: \${{ secrets.DEPLOY_KEY }}
          HOST: \${{ secrets.DEPLOY_HOST }}
        run: |
          mkdir -p ~/.ssh
          echo "$SSH_KEY" > ~/.ssh/id_ed25519
          chmod 600 ~/.ssh/id_ed25519
          ssh -o StrictHostKeyChecking=accept-new deploy@"$HOST" \\
            'cd /srv/app && git pull --ff-only && npm ci --omit=dev && sudo systemctl restart app'`;
---
