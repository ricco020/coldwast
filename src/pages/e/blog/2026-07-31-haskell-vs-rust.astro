  <figure>
    <img class="hero" src="https://images.pexels.com/photos/17342282/pexels-photo-17342282.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="Two dirt tracks diverging across a meadow under an overcast sky" width="1200" height="420" loading="eager" />
