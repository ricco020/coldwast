  <h1>CSS text-wrap: balance</h1>
  <div class="artmeta"><span>By Coldwast</span><span>Updated Sep 5, 2026</span><span>6 min read</span><span class="tag">#css</span></div>
  <nav class="toc" id="toc"></nav>
  <figure>
