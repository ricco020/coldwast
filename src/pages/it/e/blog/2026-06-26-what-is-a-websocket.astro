const srv = `// server.js  (npm i ws, ws 8.23.0, Node 22)
const { WebSocketServer } = require('ws');
const wss = new WebSocketServer({ port: 8080 });

wss.on('connection', (socket) => {
  socket.send('bienvenue');
  socket.on('message', (data) => {
    for (const client of wss.clients) {
      if (client.readyState === 1) client.send(\`echo: \${data}\`);
    }
  });
});`;
const cli = `// client.mjs (Node 22, browser)
const ws = new WebSocket('ws://localhost:8080');
ws.onopen = () => ws.send('bonjour');
ws.onmessage = (e) => console.log('recu:', e.data);`;
