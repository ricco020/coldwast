import Base from '../../../../layouts/Base.astro';
const path = '/it/e/blog/2026-06-22-what-is-ci-cd.html';
const title = 'Cos’è CI/CD? Integrazione e distribuzione continua spiegate, con una pipeline vera';
const description = 'CI/CD è l’integrazione continua (ogni push viene compilato e testato) più la consegna o il deploy continuo (il codice testato va in produzione). Definizione chiara, una pipeline GitHub Actions completa spiegata riga per riga, e dove farla girare.';
const pipeline = `# .github/workflows/ci.yml
name: ci
on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:            # CI: compilare e testare
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: npm ci
      - run: npm test

  deploy:          # CD: solo se i test passano, su main
    needs: test
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    steps:
      - name: Deploy sul server via SSH
        env:
          SSH_KEY: \${{ secrets.DEPLOY_KEY }}
          HOST: \${{ secrets.DEPLOY_HOST }}
        run: |
          mkdir -p ~/.ssh
          echo "$SSH_KEY" > ~/.ssh/id_ed25519
          chmod 600 ~/.ssh/id_ed25519
          ssh -o StrictHostKeyChecking=accept-new deploy@"$HOST" \\
            'cd /srv/app && git pull --ff-only && npm ci --omit=dev && sudo systemctl restart app'`;
---
